# ──────────────────────────────────────────────
# AI Knowledge Assistant – Environment Variables
# ──────────────────────────────────────────────

# HuggingFace (free Inference API – get token at https://huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=hf_your-token-here

# LangSmith observability (optional – free tier available)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-key-here
LANGCHAIN_PROJECT=ai-knowledge-assistant

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Embedding model (via HuggingFace Inference API – free, no local resources)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Settings (via HuggingFace Inference API – free, no local resources)
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K_RESULTS=10
RERANK_TOP_N=4
